{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:dev:generate": "prisma generate",
    "db:dev:migrate": "node prisma/assert-dev.cjs && prisma migrate dev",
    "db:dev:deploy": "node prisma/assert-dev.cjs && prisma migrate deploy",
    "db:dev:features": "node prisma/assert-dev.cjs && prisma db execute --file prisma/sql/pg-features.sql --schema prisma/schema.prisma",
    "db:dev:grants": "node prisma/assert-dev.cjs && prisma db execute --file prisma/sql/data-api-grants.sql --schema prisma/schema.prisma",
    "db:dev:studio": "node prisma/assert-dev.cjs && prisma studio",
    "db:dev:status": "node prisma/assert-dev.cjs && prisma migrate status",
    "db:dev:setup": "node prisma/assert-dev.cjs && prisma migrate deploy && prisma db execute --file prisma/sql/pg-features.sql --schema prisma/schema.prisma && prisma db execute --file prisma/sql/data-api-grants.sql --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.4.0",
    "jose": "^6.2.5",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^17.0.12",
    "react-qr-code": "^2.2.0",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "prisma": "^6.19.3",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
