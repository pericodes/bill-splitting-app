# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Neon Data API and Auth settings for client-side fetching
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-xxxx.apirest.region.aws.neon.tech/neondb/rest/v1
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth

# VITE_... fallbacks for compatibility if you copy-pasted directly from Neon
VITE_NEON_DATA_API_URL=
VITE_NEON_AUTH_URL=

# SOLO DESARROLLO. Prisma usa esta URL para migraciones y Prisma Studio.
# No definirla en producción: la app habla con Neon Data API, no con Postgres directo.
# Usa la cadena directa (no pooled) de Neon.
DEV_DATABASE_URL=""
